# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME="Goods Receipt IMS"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=your-very-secret-key-change-in-production
ALLOWED_HOSTS=["*"]

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/goods_receipt_db
DATABASE_ECHO=false

# ─── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# ─── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
